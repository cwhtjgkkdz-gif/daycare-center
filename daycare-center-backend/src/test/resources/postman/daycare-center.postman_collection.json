{
  "info": {
    "name": "托育中心管理系统 - 接口测试",
    "description": "覆盖全部12个Controller模块的接口测试集合，包含正常/异常场景自动化断言。导入后先运行「认证管理→登录成功」获取Session，再运行其他接口。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "cookie", "value": "" }
  ],
  "item": [
    {
      "name": "认证管理",
      "item": [
        {
          "name": "1.1 登录成功 (先运行此接口)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('状态码200', function(){ pm.response.to.have.status(200); });",
                "pm.test('code=200', function(){ return pm.response.json().code === 200; });",
                "pm.test('包含userInfo', function(){ return pm.response.json().data.userInfo !== undefined; });",
                "pm.test('包含menus', function(){ return Array.isArray(pm.response.json().data.menus); });",
                "var cookies = pm.response.headers.get('Set-Cookie'); if(cookies) pm.collectionVariables.set('cookie', cookies);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "1.2 登录失败-密码错误",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('状态码200', function(){ pm.response.to.have.status(200); });",
                "pm.test('code=400', function(){ return pm.response.json().code === 400; });",
                "pm.test('提示密码错误', function(){ return pm.response.json().message.indexOf('用户名或密码错误') >= 0; });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"wrong\"}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "1.3 获取当前用户信息",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('状态码200', function(){ pm.response.to.have.status(200); });",
                "pm.test('code=200', function(){ return pm.response.json().code === 200; });",
                "pm.test('用户名是admin', function(){ return pm.response.json().data.userInfo.username === 'admin'; });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "{{cookie}}" }],
            "url": { "raw": "{{base_url}}/api/auth/info", "host": ["{{base_url}}"], "path": ["api","auth","info"] }
          }
        },
        {
          "name": "1.4 退出登录",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('状态码200', function(){ pm.response.to.have.status(200); });",
                "pm.test('code=200', function(){ return pm.response.json().code === 200; });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "{{cookie}}" }],
            "url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api","auth","logout"] }
          }
        },
        {
          "name": "1.5 未登录访问受保护接口 (应返回401)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('返回401', function(){ pm.response.to.have.status(401); });",
                "pm.test('提示未登录', function(){ return pm.response.json().message.indexOf('未登录') >= 0; });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/child/page", "host": ["{{base_url}}"], "path": ["api","child","page"] }
          }
        }
      ]
